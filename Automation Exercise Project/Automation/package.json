{
  "name": "automation",
  "version": "1.0.0",
  "description": "Playwright automation tests for the Automation Exercise QA portfolio",
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test tests/api",
    "test:headed": "playwright test tests/ui --headed --workers=1",
    "test:ui": "playwright test tests/ui --ui",
    "test:ci-helpers": "node --test scripts/ci/*.test.cjs",
    "report": "node scripts/open-qa-report.cjs",
    "report:playwright": "playwright show-report test-results/html-report"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "dotenv": "^17.4.2"
  }
}
