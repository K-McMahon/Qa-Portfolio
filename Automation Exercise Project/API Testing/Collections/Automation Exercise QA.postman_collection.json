        {
          "name": "API-AUTH-001 - Verify Login with Valid Details",
          "request": {"method": "POST", "header": [], "body": {"mode": "urlencoded", "urlencoded": [{"key": "email", "value": "{{valid_email}}", "type": "text"}, {"key": "password", "value": "{{valid_password}}", "type": "text"}]}, "url": "{{base_url}}/verifyLogin", "description": "RTM: REQ-API-007 | Expected response code: 200 | Expected message: User exists!"}
        },
        {
          "name": "API-AUTH-002 - Verify Login Without Email",
