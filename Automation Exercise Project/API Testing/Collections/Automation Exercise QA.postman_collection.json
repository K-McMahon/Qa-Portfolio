          "name": "API-AUTH-004 - Verify Login with Invalid Details",
          "request": {"method": "POST", "header": [], "body": {"mode": "urlencoded", "urlencoded": [{"key": "email", "value": "{{invalid_email}}", "type": "text"}, {"key": "password", "value": "{{invalid_password}}", "type": "text"}]}, "url": "{{base_url}}/verifyLogin", "description": "RTM: REQ-API-010 | Expected response code: 404 | Expected message: User not found!"}
