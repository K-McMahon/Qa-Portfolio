    {
      "name": "05 - Account Management",
      "item": [
        {
          "name": "API-ACCOUNT-001 - Create User Account",
          "request": {"method": "POST", "header": [], "body": {"mode": "urlencoded", "urlencoded": [{"key": "name", "value": "{{user_name}}", "type": "text"}, {"key": "email", "value": "{{account_email}}", "type": "text"}, {"key": "password", "value": "{{account_password}}", "type": "text"}, {"key": "title", "value": "Mr", "type": "text"}, {"key": "birth_date", "value": "1", "type": "text"}, {"key": "birth_month", "value": "January", "type": "text"}, {"key": "birth_year", "value": "1990", "type": "text"}, {"key": "firstname", "value": "Kevin", "type": "text"}, {"key": "lastname", "value": "Tester", "type": "text"}, {"key": "company", "value": "QA Portfolio", "type": "text"}, {"key": "address1", "value": "123 Test Street", "type": "text"}, {"key": "address2", "value": "Suite 1", "type": "text"}, {"key": "country", "value": "United States", "type": "text"}, {"key": "zipcode", "value": "10001", "type": "text"}, {"key": "state", "value": "New York", "type": "text"}, {"key": "city", "value": "New York", "type": "text"}, {"key": "mobile_number", "value": "5550101000", "type": "text"}]}, "url": "{{base_url}}/createAccount", "description": "RTM: REQ-API-011 | Expected response code: 201 | Expected message: User created!"}
        },
        {
          "name": "API-ACCOUNT-002 - Delete User Account",
          "request": {"method": "DELETE", "header": [], "body": {"mode": "urlencoded", "urlencoded": [{"key": "email", "value": "{{account_email}}", "type": "text"}, {"key": "password", "value": "{{account_password}}", "type": "text"}]}, "url": "{{base_url}}/deleteAccount", "description": "RTM: REQ-API-012 | Expected response code: 200 | Expected message: Account deleted!"}
        },
        {
          "name": "API-ACCOUNT-003 - Update User Account",
          "request": {"method": "PUT", "header": [], "body": {"mode": "urlencoded", "urlencoded": [{"key": "name", "value": "{{user_name}}", "type": "text"}, {"key": "email", "value": "{{account_email}}", "type": "text"}, {"key": "password", "value": "{{account_password}}", "type": "text"}, {"key": "title", "value": "Mr", "type": "text"}, {"key": "birth_date", "value": "1", "type": "text"}, {"key": "birth_month", "value": "January", "type": "text"}, {"key": "birth_year", "value": "1990", "type": "text"}, {"key": "firstname", "value": "Kevin", "type": "text"}, {"key": "lastname", "value": "Tester", "type": "text"}, {"key": "company", "value": "QA Portfolio", "type": "text"}, {"key": "address1", "value": "123 Test Street", "type": "text"}, {"key": "address2", "value": "Suite 1", "type": "text"}, {"key": "country", "value": "United States", "type": "text"}, {"key": "zipcode", "value": "10001", "type": "text"}, {"key": "state", "value": "New York", "type": "text"}, {"key": "city", "value": "New York", "type": "text"}, {"key": "mobile_number", "value": "5550101000", "type": "text"}]}, "url": "{{base_url}}/updateAccount", "description": "RTM: REQ-API-013 | Expected response code: 200 | Expected message: User updated!"}
        },
        {
          "name": "API-ACCOUNT-004 - Get User Details by Email",
          "request": {"method": "GET", "header": [], "url": {"raw": "{{base_url}}/getUserDetailByEmail?email={{account_email}}", "host": ["{{base_url}}"], "path": ["getUserDetailByEmail"], "query": [{"key": "email", "value": "{{account_email}}"}]}, "description": "RTM: REQ-API-014 | Expected response code: 200 | Expected response: User Detail"}
